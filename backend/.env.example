# Copier ce fichier en .env (ou .env.local) puis adapter les valeurs.
APP_ENV=dev
APP_SECRET=remplacez_par_une_chaine_aleatoire
DEFAULT_URI=http://127.0.0.1:8000
APP_TIMEZONE=Africa/Tunis

# XAMPP : MySQL root sans mot de passe
DATABASE_URL="mysql://root:@127.0.0.1:3306/smartkine?serverVersion=8.0.32&charset=utf8mb4"

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=smartkine
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
# Mailpit (facultatif) : SMTP sur le port 1025, interface web sur http://localhost:8025
MAILER_DSN=smtp://127.0.0.1:1025
MAILER_FROM=no-reply@smartkine.tn
###< symfony/mailer ###

# Adresse du frontend Angular (liens dans les e-mails, CORS)
FRONTEND_URL=http://localhost:4200
CORS_ALLOW_ORIGIN=http://localhost:4200
